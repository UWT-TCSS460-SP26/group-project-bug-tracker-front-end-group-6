# Copy this file to .env.local and fill in the values.
# This file is safe to commit — it contains no secrets.

# Your deployed API base URL (no trailing slash).
NEXT_PUBLIC_API_URL=https://tcss460-team-6-api.onrender.com

# NextAuth — generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Auth² OAuth client (group-6-api audience) from your course tenant
AUTH_ISSUER=https://tcss-460-iam.onrender.com
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
API_AUDIENCE=group-6-api

# Local-only triage bypass (pairs with backend DEV_BYPASS_TRIAGE=true)
NEXT_PUBLIC_TRIAGE_DEV_BYPASS=false
NEXT_PUBLIC_TRIAGE_DEV_ROLE=Admin
